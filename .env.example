# ==============================================================================
# Dolce Vita - Environment Variables (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (Supabase PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# DATABASE_URL: Cadena de conexión con pooler (Transaction Pooler, puerto 6543).
# Utilizada para las consultas en tiempo de ejecución de la aplicación.
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Cadena de conexión directa (Session Mode / Direct, puerto 5432).
# Requerida obligatoriamente por Prisma para ejecutar migraciones (Prisma Migrate).
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Autenticación y Sesiones (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# AUTH_SECRET: Clave criptográfica aleatoria para firmar JWT y cookies.
# Puedes generar una ejecutando: npx auth secret  o  openssl rand -base64 32
AUTH_SECRET="dolce-vita-super-secret-key-32-chars-min-change-in-prod!"

# NEXTAUTH_URL: URL base de la aplicación.
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Proveedores de Inteligencia Artificial (LLM)
# ------------------------------------------------------------------------------
# OpenRouter API Key (https://openrouter.ai/)
OPENROUTER_API_KEY="sk-or-v1-tu-openrouter-api-key-aqui"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Groq API Key (https://console.groq.com/)
GROQ_API_KEY="gsk_tu-groq-api-key-aqui"

# Proveedor y Modelo por Defecto para el Asistente George
DEFAULT_AI_PROVIDER="OPENROUTER"
DEFAULT_AI_MODEL="openai/gpt-4o-mini"

# ------------------------------------------------------------------------------
# 4. Configuración de Aplicación y Entorno
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. Usuarios Demo Predefinidos (Autenticación Rápida en Front)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_USER_EMAIL="user@dolcevita.com"
NEXT_PUBLIC_DEMO_USER_PASSWORD="User1234!"
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="admin@dolcevita.com"
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="Admin1234!"
